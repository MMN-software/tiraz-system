@import "tailwindcss";

@theme {
  /* ===== Primary: آبی-فیروزه‌ای (پزشکی + مدرن) ===== */
  --color-brand-50:  #ecfeff;
  --color-brand-100: #cffafe;
  --color-brand-200: #a5f3fc;
  --color-brand-300: #67e8f9;
  --color-brand-400: #22d3ee;
  --color-brand-500: #06b6d4;
  --color-brand-600: #0891b2;
  --color-brand-700: #0e7490;
  --color-brand-800: #155e75;
  --color-brand-900: #164e63;

  /* ===== Secondary: سبز زمردی (سلامت، اعتماد) ===== */
  --color-accent-50:  #ecfdf5;
  --color-accent-100: #d1fae5;
  --color-accent-200: #a7f3d0;
  --color-accent-300: #6ee7b7;
  --color-accent-400: #34d399;
  --color-accent-500: #10b981;
  --color-accent-600: #059669;
  --color-accent-700: #047857;

  /* ===== CTA Accent: نارنجی گرم (انرژی، توجه) ===== */
  --color-coral-50:  #fff7ed;
  --color-coral-100: #ffedd5;
  --color-coral-200: #fed7aa;
  --color-coral-300: #fdba74;
  --color-coral-400: #fb923c;
  --color-coral-500: #f97316;
  --color-coral-600: #ea580c;
  --color-coral-700: #c2410c;

  /* ===== Ink: خاکستری‌های نرم ===== */
  --color-ink-50:  #f8fafc;
  --color-ink-100: #f1f5f9;
  --color-ink-200: #e2e8f0;
  --color-ink-300: #cbd5e1;
  --color-ink-400: #94a3b8;
  --color-ink-500: #64748b;
  --color-ink-600: #475569;
  --color-ink-700: #334155;
  --color-ink-800: #1e293b;
  --color-ink-900: #0f172a;

  /* ===== وضعیت‌ها ===== */
  --color-success: #10b981;
  --color-warning: #f59e0b;
  --color-danger:  #dc2626;

  /* ===== فونت ===== */
  --font-sans: var(--font-vazirmatn), ui-sans-serif, system-ui, -apple-system, sans-serif;
}

html {
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
  padding: env(safe-area-inset-top) env(safe-area-inset-right) 0 env(safe-area-inset-left);
}

body {
  font-family: var(--font-sans);
  background-color: var(--color-ink-50);
  color: var(--color-ink-900);
  line-height: 1.8;
  font-feature-settings: "kern", "liga";
  -webkit-font-smoothing: antialiased;
  min-height: 100vh;
}

:focus-visible {
  outline: 2px solid var(--color-brand-500);
  outline-offset: 2px;
  border-radius: 6px;
}

::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-track { background: var(--color-ink-100); }
::-webkit-scrollbar-thumb { background: var(--color-ink-300); border-radius: 4px; }
::-webkit-scrollbar-thumb:hover { background: var(--color-ink-400); }

::selection { background: var(--color-brand-600); color: #fff; }

a { color: inherit; text-decoration: none; }

.num { font-variant-numeric: tabular-nums; }

@media (hover: none) {
  button, a { -webkit-tap-highlight-color: transparent; }
}

@media (max-width: 374px) {
  .container {
    padding-left: 0.75rem;
    padding-right: 0.75rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

html, body { overflow-x: hidden; }

@keyframes toastIn {
  from {
    opacity: 0;
    transform: translateY(-8px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* کلاس کمکی برای ارتفاع ۵۲ پیکسل */
.h-13 {
  height: 3.25rem;
}

/* ==========================================================================
   Animation System — professional, subtle, RTL-safe
   ========================================================================== */

/* --- 1) Scroll-triggered keyframes --- */
@keyframes anim-fade-up {
  from { opacity: 0; transform: translateY(24px); }
  to   { opacity: 1; transform: none; }
}
@keyframes anim-fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}
@keyframes anim-scale-in {
  from { opacity: 0; transform: scale(0.96); }
  to   { opacity: 1; transform: none; }
}

@supports (animation-timeline: view()) {
  @media (prefers-reduced-motion: no-preference) {
    .anim-on-scroll {
      animation: anim-fade-up linear both;
      animation-timeline: view();
      animation-range: entry 10% entry 40%;
    }
    .anim-on-scroll-fade {
      animation: anim-fade-in linear both;
      animation-timeline: view();
      animation-range: entry 15% entry 45%;
    }
    .anim-on-scroll-scale {
      animation: anim-scale-in linear both;
      animation-timeline: view();
      animation-range: entry 10% entry 35%;
    }
  }
}

/* --- 2) Initial hero-rise (on mount, not scroll) --- */
@keyframes anim-rise {
  from { opacity: 0; transform: translateY(18px); }
  to   { opacity: 1; transform: none; }
}
.anim-rise {
  opacity: 0;
  transform: translateY(18px);
  animation: anim-rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  animation-delay: var(--d, 0ms);
}
@media (prefers-reduced-motion: reduce) {
  .anim-rise {
    opacity: 1;
    transform: none;
    animation: none;
  }
}

/* --- 3) Marquee (logos carousel) --- */
@keyframes anim-marquee-rtl {
  from { transform: translateX(50%); }
  to   { transform: translateX(0); }
}
@media (prefers-reduced-motion: no-preference) {
  .anim-marquee {
    animation: anim-marquee-rtl 40s linear infinite;
    will-change: transform;
  }
  .anim-marquee-pause:hover .anim-marquee,
  .anim-marquee-pause:focus-within .anim-marquee {
    animation-play-state: paused;
  }
}

/* --- 4) Shimmer (buttons on hover) --- */
@keyframes anim-shimmer {
  0%   { transform: translateX(-150%); }
  100% { transform: translateX(150%); }
}
.anim-shimmer {
  position: relative;
  overflow: hidden;
  isolation: isolate;
}
.anim-shimmer::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    105deg,
    transparent 40%,
    rgb(255 255 255 / 0.22) 50%,
    transparent 60%
  );
  transform: translateX(-150%);
  pointer-events: none;
  z-index: 1;
}
@media (prefers-reduced-motion: no-preference) {
  .anim-shimmer:hover::before,
  .anim-shimmer:focus-visible::before {
    animation: anim-shimmer 1.2s ease-out;
  }
}

/* --- 5) Pulse-soft (live indicator) --- */
@keyframes anim-pulse-soft {
  0%, 100% { opacity: 1; }
  50%      { opacity: 0.5; }
}
@media (prefers-reduced-motion: no-preference) {
  .anim-pulse-soft {
    animation: anim-pulse-soft 2s ease-in-out infinite;
  }
}

/* --- 6) Slow rotation (star icons) --- */
@keyframes anim-rotate-slow {
  to { transform: rotate(360deg); }
}
@media (prefers-reduced-motion: no-preference) {
  .anim-rotate-slow {
    animation: anim-rotate-slow 60s linear infinite;
    will-change: transform;
  }
}

/* --- 7) Hover lift (cards) --- */
.anim-lift {
  transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
              box-shadow 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
}
@media (prefers-reduced-motion: no-preference) {
  .anim-lift:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px -12px rgba(15, 42, 51, 0.15);
  }
}

/* --- 8) Icon rotation on parent hover --- */
.anim-icon-rotate {
  transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
}
@media (prefers-reduced-motion: no-preference) {
  .group:hover .anim-icon-rotate,
  .group:focus-within .anim-icon-rotate {
    transform: rotate(8deg) scale(1.05);
  }
}

/* --- 9) Underline grow (nav links) --- */
.anim-underline {
  position: relative;
}
.anim-underline::after {
  content: "";
  position: absolute;
  inset-inline-end: 0;
  bottom: -2px;
  height: 2px;
  width: 100%;
  background-color: currentColor;
  transform: scaleX(0);
  transform-origin: right center;
  transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
}
@media (prefers-reduced-motion: no-preference) {
  .anim-underline:hover::after,
  .anim-underline:focus-visible::after {
    transform: scaleX(1);
  }
}
@media (prefers-reduced-motion: reduce) {
  .anim-underline:hover::after,
  .anim-underline:focus-visible::after {
    transform: scaleX(1);
    transition: none;
  }
}

/* --- 10) Link indent (footer links) --- */
.anim-indent {
  display: inline-block;
  transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1);
}
@media (prefers-reduced-motion: no-preference) {
  .anim-indent:hover,
  .anim-indent:focus-visible {
    transform: translateX(-4px);
  }
}

/* --- 11) Line grow (decorative lines) --- */
@keyframes anim-line-grow {
  from { transform: scaleX(0); opacity: 0; }
  to   { transform: scaleX(1); opacity: 1; }
}
.anim-line-grow {
  transform-origin: center;
}
@supports (animation-timeline: view()) {
  @media (prefers-reduced-motion: no-preference) {
    .anim-line-grow {
      animation: anim-line-grow 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-timeline: view();
      animation-range: entry 10% entry 40%;
    }
  }
}

/* --- 12) Safety net for prefers-reduced-motion --- */

/* ==========================================================================
   Scroll-reveal (IntersectionObserver-based, all browsers)
   ========================================================================== */

.anim-on-scroll {
  opacity: 0;
  transform: translateY(28px);
  transition:
    opacity 0.8s cubic-bezier(0.2, 0.7, 0.2, 1),
    transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  will-change: opacity, transform;
}
.anim-on-scroll.is-visible {
  opacity: 1;
  transform: none;
}

.anim-on-scroll-fade {
  opacity: 0;
  transition: opacity 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
}
.anim-on-scroll-fade.is-visible {
  opacity: 1;
}

.anim-on-scroll-scale {
  opacity: 0;
  transform: scale(0.95);
  transition:
    opacity 0.8s cubic-bezier(0.2, 0.7, 0.2, 1),
    transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
}
.anim-on-scroll-scale.is-visible {
  opacity: 1;
  transform: none;
}

/* خطوط تزئینی */
.anim-line-grow {
  transform-origin: center;
  transform: scaleX(0);
  opacity: 0;
  transition:
    transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1),
    opacity 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
}
.anim-line-grow.is-visible {
  transform: scaleX(1);
  opacity: 1;
}


/* ==========================================================================
   Motion CSS — hover, marquee, shimmer, pulse, rotate
   ========================================================================== */

/* --- Shimmer (درخشش روی دکمه‌های CTA) --- */
@keyframes motion-shimmer {
  0%   { transform: translateX(-150%); }
  100% { transform: translateX(150%); }
}
.motion-shimmer {
  position: relative;
  overflow: hidden;
  isolation: isolate;
}
.motion-shimmer::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    105deg,
    transparent 40%,
    rgb(255 255 255 / 0.22) 50%,
    transparent 60%
  );
  transform: translateX(-150%);
  pointer-events: none;
  z-index: 1;
}
@media (prefers-reduced-motion: no-preference) {
  .motion-shimmer:hover::before,
  .motion-shimmer:focus-visible::before {
    animation: motion-shimmer 1.2s ease-out;
  }
}

/* --- Pulse-soft (چراغ پایش زنده) --- */
@keyframes motion-pulse-soft {
  0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgb(16 185 129 / 0.5); }
  50%      { opacity: 0.75; box-shadow: 0 0 0 6px rgb(16 185 129 / 0); }
}
@media (prefers-reduced-motion: no-preference) {
  .motion-pulse-soft {
    animation: motion-pulse-soft 2.2s ease-in-out infinite;
  }
}

/* --- Slow rotation (ستاره‌های تزئینی) --- */
@keyframes motion-rotate-slow {
  to { transform: rotate(360deg); }
}
@media (prefers-reduced-motion: no-preference) {
  .motion-rotate-slow {
    animation: motion-rotate-slow 60s linear infinite;
    will-change: transform;
  }
}

/* --- Marquee (کاروسل بی‌نهایت — LTR، داخل RTL wrapper) --- */
@keyframes motion-marquee {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}
@media (prefers-reduced-motion: no-preference) {
  .motion-marquee {
    animation: motion-marquee 40s linear infinite;
    will-change: transform;
  }
  .motion-marquee-pause:hover .motion-marquee,
  .motion-marquee-pause:focus-within .motion-marquee {
    animation-play-state: paused;
  }
}

/* --- Card lift (بالا آمدن کارت روی hover) --- */
.motion-card-lift {
  transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
              box-shadow 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
}
@media (prefers-reduced-motion: no-preference) {
  .motion-card-lift:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px -16px rgba(15, 42, 51, 0.18);
  }
}

/* --- Icon rotate (چرخش ظریف آیکون روی hover کارت) --- */
.motion-icon-rotate {
  transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
}
@media (prefers-reduced-motion: no-preference) {
  .group:hover .motion-icon-rotate,
  .group:focus-within .motion-icon-rotate {
    transform: rotate(8deg) scale(1.06);
  }
}

/* --- Underline (خط رشد از راست روی لینک‌های nav) --- */
.motion-underline {
  position: relative;
}
.motion-underline::after {
  content: "";
  position: absolute;
  inset-inline-end: 0;
  bottom: -2px;
  height: 2px;
  width: 100%;
  background-color: currentColor;
  transform: scaleX(0);
  transform-origin: right center;
  transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
}
@media (prefers-reduced-motion: no-preference) {
  .motion-underline:hover::after,
  .motion-underline:focus-visible::after {
    transform: scaleX(1);
  }
}
@media (prefers-reduced-motion: reduce) {
  .motion-underline:hover::after,
  .motion-underline:focus-visible::after {
    transform: scaleX(1);
    transition: none;
  }
}

/* --- Safety net for reduced-motion --- */
@media (prefers-reduced-motion: reduce) {
  .motion-shimmer::before,
  .motion-pulse-soft,
  .motion-rotate-slow,
  .motion-marquee {
    animation: none !important;
  }
  .motion-card-lift,
  .motion-icon-rotate {
    transition: none;
  }
}

/* ==========================================================================
   ECG Heartbeat — cardiac monitor line for Hero
   ========================================================================== */

@keyframes motion-ecg-trace {
  to { stroke-dashoffset: -1200; }
}

.ecg-trace {
  stroke-dasharray: 240 1200;
  stroke-dashoffset: 240;
}
@media (prefers-reduced-motion: no-preference) {
  .ecg-trace {
    animation: motion-ecg-trace 4s linear infinite;
  }
}
@media (prefers-reduced-motion: reduce) {
  .ecg-trace {
    animation: none;
    stroke-dasharray: none;
    stroke-dashoffset: 0;
  }
}

/* چراغ پالس ECG (نقطه‌ی ابتدای نوار) */
@keyframes motion-ecg-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%      { opacity: 0.6; transform: scale(0.85); }
}
@media (prefers-reduced-motion: no-preference) {
  .ecg-pulse {
    animation: motion-ecg-pulse 1.2s ease-in-out infinite;
  }
}
